# =============================================================================
# Variables de entorno del microservicio de mensajería (plazoleta-mensajeria)
# Copia este archivo como .env en la raíz del proyecto:  Copy-Item .env.example .env
# El archivo .env no se sube a git.
# =============================================================================

# --- Seguridad compartida con plazoleta-usuarios y plazoleta-restaurantes (debe ser IGUAL) ---
# Token para las rutas /internal/** entre microservicios
USERS_INTERNAL_TOKEN=cambia-este-token-interno

# --- Proveedor de SMS ---
# simulated = escribe el SMS en la consola (no necesita cuenta de Twilio)
# twilio    = envía el SMS de verdad con Twilio
SMS_PROVIDER=simulated

# --- Twilio (solo si SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio que envía los mensajes, con + y código de país. Ejemplo: +15005550006
TWILIO_FROM_NUMBER=
